    <Midl Include="ProcessItem.idl" />
  </ItemGroup>
  <ItemGroup>
    <!-- Infrastructure (gRPC, protobuf, OpenSSL, yaml-cpp) lives in this DLL. -->
    <CopyFileToFolders Include="$(TalmonCoreOutDir)talmon_backend.dll">
      <DestinationFolders>$(OutDir)</DestinationFolders>
    </CopyFileToFolders>
  </ItemGroup>
  <Target Name="TalmonCheckCoreLibraries" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TalmonCoreOutDir)talmon_backend.lib')"
           Text="Core libraries not found in $(TalmonCoreOutDir). Build them first: cmake --preset windows-x64 &amp;&amp; cmake --build --preset $(Configuration.ToLower()) (or run build.ps1)." />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
