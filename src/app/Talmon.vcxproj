      <DependentUpon>ServiceItem.idl</DependentUpon>
    </ClInclude>
    <ClInclude Include="ProcessItem.h">
      <DependentUpon>ProcessItem.idl</DependentUpon>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="DashboardPage.xaml" />
    <Page Include="ServicesPage.xaml" />
    <Page Include="ProcessesPage.xaml" />
    <Page Include="LogsPage.xaml" />
    <Page Include="SettingsPage.xaml" />
  </ItemGroup>
  <ItemGroup>
